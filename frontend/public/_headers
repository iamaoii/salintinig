# =============================================================================
# SalinTinig Cloudflare Pages Global Security & Performance Headers
# =============================================================================

/*
  # Security Headers
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=()
  X-XSS-Protection: 1; mode=block

# Aggressive Caching for Static Images & Assets (1 Year Browser Cache)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Ensure index.html always gets revalidated so users instantly see new deployments
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
