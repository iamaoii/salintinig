# Server Port
PORT=5000

# Database Connection (Supabase / PostgreSQL Direct URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT Secret & Expiration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# Cloudinary Storage (For Audio Recordings & Student Avatars)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Supabase API (Optional / SDK reference)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend Email API (For Password Reset Emails)
RESEND_API_KEY=re_your_resend_api_key_here

# Speech-To-Text Engine Credentials (Groq Whisper Large v3)
GROQ_API_KEY=gsk_your_groq_api_key_here